test-media/
out_*.json

# 依赖
node_modules/

# 模型资产（HF 下载；获取方式见 README「获取模型」）
**/models/

# 构建产物
dist/
frontend/.vitest/
app/frontend/
app/build/bin/
*.exe

# 误入库的调试二进制（历史遗留，见 8d1b1b6）
app/zimugo

