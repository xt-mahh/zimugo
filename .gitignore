# 测试媒体
test-media/
out_*.json

# 依赖
node_modules/

# 模型资产：whisper 大模型不进 git（超 100M 硬限，Pages 走 ModelScope）
**/models/**
!**/models/silero-vad/
!frontend/public/models/silero-vad/silero_vad.onnx

# 构建产物
dist/
frontend/.vitest/
app/frontend/
app/build/bin/
*.exe

# 误入库的调试二进制（历史遗留，见 8d1b1b6）
app/localsub
app/zimugo

# ort wasm 二进制（npm 包内容物，构建时由 build-desktop.sh / CI 拷入 public/ort）
frontend/public/ort/
frontend/public/workers/*.wasm
frontend/public/workers/*.mjs
frontend/public/node_modules/

# 本地 HTTPS 自签证书（私钥不入库）
phase0/cert.pem
phase0/key.pem
*.pem

# 内部工作区（运营/状态/POC/证书——永不入库）
internal/
RELEASE-STATUS.md
OPERATIONS.md
